# Cadena de conexión a PostgreSQL
DB_URL=postgres://postgres:postgres@localhost:5432/umi?sslmode=disable

# Puerto del servidor HTTP (por omisión: 8080)
PORT=8080

# Nivel de registro: debug, info, warn, error (por omisión: info)
LOG_LEVEL=info

# Clave secreta para firmar JWT (requerida)
JWT_SECRET=change-me-to-a-secure-random-string

# Tarifa por kilómetro para cálculo de tarifa (por omisión: 8.0)
FARE_RATE_PER_KM=8.0

# Tarifa mínima para cálculo de tarifa (por omisión: 25.0)
FARE_MINIMUM=25.0
